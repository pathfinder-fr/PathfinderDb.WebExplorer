@page "/sorts/{initial?}"
@model PathfinderDb.Web.Pages.Spells.IndexModel
@{
    ViewData["Title"] = "Sorts";
}
<section class="page-card">
    <p class="eyebrow">Catalogue</p>
    <h1>Sorts</h1>
    <p class="intro">Consultez les sorts et leurs niveaux par ordre alphabétique.</p>
    <nav class="bucket-nav" aria-label="Initiales">
        @foreach (var bucket in Model.Buckets) { <a href="/sorts/@bucket">@bucket</a> }
    </nav>
    <h2>Lettre @Model.CatalogPage!.Bucket</h2>
    <ol class="catalog-list">
        @foreach (var spell in Model.CatalogPage.Items) { <li><a href="/sorts/detail/@spell.Id">@spell.Name</a></li> }
    </ol>
    <nav class="pagination" aria-label="Pagination">
        @if (Model.CatalogPage.HasPreviousPage) { <a href="/sorts/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
        <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
        @if (Model.CatalogPage.HasNextPage) { <a href="/sorts/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
    </nav>
</section>
