@page "/sorts/niveau/{level}"
@model PathfinderDb.Web.Pages.Spells.ByLevelModel
@{
    ViewData["Title"] = $"Sorts de niveau {Model.CatalogPage!.Bucket}";
}
<section class="page-card">
    <p><a href="/sorts">← Tous les sorts</a></p>
    <p class="eyebrow">Catalogue par niveau</p>
    <h1>Sorts de niveau @Model.CatalogPage!.Bucket</h1>
    <ol class="catalog-list">
        @foreach (var spell in Model.CatalogPage.Items)
        {
            <partial name="_SpellCatalogItem" model="spell" />
        }
    </ol>
    <nav class="pagination" aria-label="Pagination">
        @if (Model.CatalogPage.HasPreviousPage) { <a href="/sorts/niveau/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
        <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
        @if (Model.CatalogPage.HasNextPage) { <a href="/sorts/niveau/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
    </nav>
</section>
