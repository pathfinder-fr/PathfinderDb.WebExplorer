@page "/sorts/classe/{class}"
@model PathfinderDb.Web.Pages.Spells.ByClassModel
@{
    ViewData["Title"] = $"Sorts de la classe {CatalogText.FormatSpellList(Model.CatalogPage!.Bucket)}";
}
<section class="page-card">
    <p><a href="/sorts">← Tous les sorts</a></p>
    <p class="eyebrow">Catalogue par classe</p>
    <h1>Sorts de la classe @CatalogText.FormatSpellList(Model.CatalogPage!.Bucket)</h1>
    <ol class="catalog-list">
        @foreach (var spell in Model.CatalogPage.Items)
        {
            <li><a href="/sorts/detail/@spell.Id">@spell.Name</a></li>
        }
    </ol>
    <nav class="pagination" aria-label="Pagination">
        @if (Model.CatalogPage.HasPreviousPage) { <a href="/sorts/classe/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
        <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
        @if (Model.CatalogPage.HasNextPage) { <a href="/sorts/classe/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
    </nav>
</section>
