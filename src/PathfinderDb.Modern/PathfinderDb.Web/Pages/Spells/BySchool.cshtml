@page "/sorts/ecole/{school}"
@model PathfinderDb.Web.Pages.Spells.BySchoolModel
@{
    ViewData["Title"] = $"Sorts de l'école {CatalogText.FormatSpellSchool(Model.CatalogPage!.Bucket)}";
}
<section class="page-card">
    <p><a href="/sorts">← Tous les sorts</a></p>
    <p class="eyebrow">Catalogue par école</p>
    <h1>Sorts de l'école @CatalogText.FormatSpellSchool(Model.CatalogPage!.Bucket)</h1>
    <ol class="catalog-list">
        @foreach (var spell in Model.CatalogPage.Items)
        {
            <li><a href="/sorts/detail/@spell.Id">@spell.Name</a></li>
        }
    </ol>
    <nav class="pagination" aria-label="Pagination">
        @if (Model.CatalogPage.HasPreviousPage) { <a href="/sorts/ecole/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
        <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
        @if (Model.CatalogPage.HasNextPage) { <a href="/sorts/ecole/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
    </nav>
</section>
