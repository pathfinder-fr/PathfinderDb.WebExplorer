@page "/monstres/{initial?}"
@model PathfinderDb.Web.Pages.Monsters.IndexModel
@{
    ViewData["Title"] = "Monstres";
}
<section class="page-card">
    <p class="eyebrow">Catalogue</p>
    <h1>Monstres</h1>
    <p class="intro">Choisissez un facteur de puissance pour parcourir les créatures.</p>
    <h2>Par facteur de puissance</h2>
    <nav class="catalog-list" aria-label="Facteurs de puissance">
        @foreach (var challengeRating in Model.ChallengeRatings)
        {
            <a href="/monstres/cr/@CatalogText.FormatChallengeRating(challengeRating)">@CatalogText.FormatChallengeRating(challengeRating)</a>
        }
    </nav>
    <h2>Par type</h2>
    <nav class="catalog-list" aria-label="Types de monstres">
        @foreach (var type in Model.Types)
        {
            <a href="/monstres/type/@type">@CatalogText.FormatMonsterType(type)</a>
        }
    </nav>
    <h2>Par source</h2>
    <nav class="catalog-list" aria-label="Sources des monstres">
        @foreach (var source in Model.Sources)
        {
            <a href="/monstres/source/@source">@CatalogText.FormatSource(source)</a>
        }
    </nav>
    <h2>Par ordre alphabétique</h2>
    <nav class="catalog-list" aria-label="Initiales">
        @foreach (var bucket in Model.InitialBuckets)
        {
            <a href="/monstres/@bucket">@bucket</a>
        }
    </nav>
    @if (Model.CatalogPage is not null)
    {
        <h2>Lettre @Model.CatalogPage.Bucket</h2>
        <ol class="catalog-list">
            @foreach (var monster in Model.CatalogPage.Items)
            {
                <li><a href="/monstres/detail/@monster.Id">@monster.Name</a></li>
            }
        </ol>
        <nav class="pagination" aria-label="Pagination">
            @if (Model.CatalogPage.HasPreviousPage) { <a href="/monstres/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
            <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
            @if (Model.CatalogPage.HasNextPage) { <a href="/monstres/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
        </nav>
    }
</section>
