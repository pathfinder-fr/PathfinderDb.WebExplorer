@page "/monstres"
@model PathfinderDb.Web.Pages.Monsters.IndexModel
@{
    ViewData["Title"] = "Monstres";
}
<section class="page-card">
    <p class="eyebrow">Catalogue</p>
    <h1>Monstres</h1>
    <p class="intro">Choisissez un facteur de puissance pour parcourir les créatures.</p>
    <h2>Par facteur de puissance</h2>
    <ul class="catalog-list">
        @foreach (var challengeRating in Model.ChallengeRatings)
        {
            <li><a href="/monstres/cr/@challengeRating">@challengeRating</a></li>
        }
    </ul>
    <h2>Par type</h2>
    <ul class="catalog-list">
        @foreach (var type in Model.Types)
        {
            <li><a href="/monstres/type/@type">@type</a></li>
        }
    </ul>
    <h2>Par source</h2>
    <ul class="catalog-list">
        @foreach (var source in Model.Sources)
        {
            <li><a href="/monstres/source/@source">@source</a></li>
        }
    </ul>
</section>
