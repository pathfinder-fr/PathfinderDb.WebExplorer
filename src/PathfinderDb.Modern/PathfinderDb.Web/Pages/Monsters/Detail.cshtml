@page "/monstres/{slug}"
@model PathfinderDb.Web.Pages.Monsters.DetailModel
<!doctype html>
<html lang="fr">
<head><meta charset="utf-8" /><title>@Model.Monster!.Name - Monstre</title></head>
<body>
<main>
    <p><a href="/monstres">Tous les monstres</a></p>
    <h1>@Model.Monster!.Name</h1>
    <dl>
        <dt>CR</dt><dd>@Model.Monster.ChallengeRating</dd>
        <dt>Type</dt><dd>@Model.Monster.Type</dd>
        <dt>Environnement</dt><dd>@Model.Monster.Environment</dd>
        <dt>Climat</dt><dd>@Model.Monster.Climate</dd>
    </dl>
    <p>Cette fiche est un résumé de catalogue : le jeu de données actuel ne fournit pas de statblock complet.</p>
</main>
</body>
</html>
