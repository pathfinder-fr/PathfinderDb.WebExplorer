@page "/monstres/source/{source}"
@model PathfinderDb.Web.Pages.Monsters.BySourceModel
@{
    ViewData["Title"] = $"Monstres de la source {CatalogText.FormatSource(Model.CatalogPage!.Bucket)}";
}
<section class="page-card">
    <p><a href="/monstres">← Tous les monstres</a></p>
    <p class="eyebrow">Catalogue par source</p>
    <h1>Monstres de la source @CatalogText.FormatSource(Model.CatalogPage!.Bucket)</h1>
    <ol class="catalog-list">
        @foreach (var monster in Model.CatalogPage.Items)
        {
            <li><a href="/monstres/detail/@monster.Id">@monster.Name</a></li>
        }
    </ol>
    <nav class="pagination" aria-label="Pagination">
        @if (Model.CatalogPage.HasPreviousPage) { <a href="/monstres/source/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
        <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
        @if (Model.CatalogPage.HasNextPage) { <a href="/monstres/source/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
    </nav>
</section>
