@page "/dons/type/{type}"
@model PathfinderDb.Web.Pages.Feats.ByTypeModel
@{
    ViewData["Title"] = $"Dons de type {CatalogText.FormatFeatType(Model.CatalogPage!.Bucket)}";
}
<section class="page-card">
    <p><a href="/dons">← Tous les dons</a></p>
    <p class="eyebrow">Catalogue par type</p>
    <h1>Dons de type @CatalogText.FormatFeatType(Model.CatalogPage!.Bucket)</h1>
    <ol class="catalog-list">
        @foreach (var feat in Model.CatalogPage.Items)
        {
            <li><a href="/dons/detail/@feat.Id">@feat.Name</a></li>
        }
    </ol>
    <nav class="pagination" aria-label="Pagination">
        @if (Model.CatalogPage.HasPreviousPage) { <a href="/dons/type/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
        <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
        @if (Model.CatalogPage.HasNextPage) { <a href="/dons/type/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
    </nav>
</section>
