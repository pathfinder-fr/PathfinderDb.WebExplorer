@page "/dons/{initial?}"
@model PathfinderDb.Web.Pages.Feats.IndexModel
@{
    ViewData["Title"] = "Dons";
}
<section class="page-card">
    <p class="eyebrow">Catalogue</p>
    <h1>Dons</h1>
    <p class="intro">Retrouvez les dons par ordre alphabétique.</p>
    <nav class="bucket-nav" aria-label="Initiales">
        @foreach (var bucket in Model.Buckets)
        {
            <a href="/dons/@bucket">@bucket</a>
        }
    </nav>
    <h2>Lettre @Model.CatalogPage!.Bucket</h2>
    <ol class="catalog-list">
        @foreach (var feat in Model.CatalogPage.Items)
        {
            <li><a href="/dons/detail/@feat.Id">@feat.Name</a></li>
        }
    </ol>
    <nav class="pagination" aria-label="Pagination">
        @if (Model.CatalogPage.HasPreviousPage) { <a href="/dons/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
        <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
        @if (Model.CatalogPage.HasNextPage) { <a href="/dons/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
    </nav>
</section>
