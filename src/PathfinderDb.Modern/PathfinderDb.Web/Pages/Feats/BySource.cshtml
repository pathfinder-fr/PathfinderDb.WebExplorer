@page "/dons/source/{source}"
@model PathfinderDb.Web.Pages.Feats.BySourceModel
@{
    ViewData["Title"] = $"Dons de la source {Model.CatalogPage!.Bucket}";
}
<section class="page-card">
    <p><a href="/dons">← Tous les dons</a></p>
    <p class="eyebrow">Catalogue par source</p>
    <h1>Dons de la source @Model.CatalogPage!.Bucket</h1>
    <ol class="catalog-list">
        @foreach (var feat in Model.CatalogPage.Items)
        {
            <li><a href="/dons/detail/@feat.Id">@feat.Name</a></li>
        }
    </ol>
    <nav class="pagination" aria-label="Pagination">
        @if (Model.CatalogPage.HasPreviousPage) { <a href="/dons/source/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page - 1)">Précédent</a> }
        <span>Page @Model.CatalogPage.Page / @Model.CatalogPage.PageCount</span>
        @if (Model.CatalogPage.HasNextPage) { <a href="/dons/source/@Model.CatalogPage.Bucket?page=@(Model.CatalogPage.Page + 1)">Suivant</a> }
    </nav>
</section>
