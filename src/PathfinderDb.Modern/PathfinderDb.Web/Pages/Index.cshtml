@page
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
}
<section class="page-card">
    <img class="brand-mark" src="/images/pf-fr-db.png" alt="Pathfinder FR DB" />
    <p class="eyebrow">Référence Pathfinder en français</p>
    <h1>Les règles à portée de dés</h1>
    <p class="intro">Trouvez rapidement un don, un sort ou un monstre pour préparer vos parties.</p>
    <div class="portal-grid">
        <a class="portal-card" href="/dons">
            <strong>Dons</strong>
            <span>Talents, prérequis et avantages</span>
        </a>
        <a class="portal-card" href="/sorts">
            <strong>Sorts</strong>
            <span>Écoles, classes et composantes</span>
        </a>
        <a class="portal-card" href="/monstres">
            <strong>Monstres</strong>
            <span>CR, types et sources</span>
        </a>
    </div>
</section>
<section class="technical-status page-card">
    <p class="eyebrow">État du catalogue</p>
    <h2>Informations techniques</h2>
    <p>État des données : <strong>@Model.Status.State</strong></p>
    @if (Model.Status.Version is not null)
    {
        <p>Version : <code>@Model.Status.Version</code></p>
        <div class="detail-grid">
            <div><dt>Dons</dt><dd>@Model.Status.FeatCount</dd></div>
            <div><dt>Sorts</dt><dd>@Model.Status.SpellCount</dd></div>
            <div><dt>Monstres</dt><dd>@Model.Status.MonsterCount</dd></div>
        </div>
    }
    <p>
        Les données sont chargées depuis les exports publics de Pathfinder FR.
    </p>
    @if (Model.Status.Errors.Count > 0)
    {
        <p role="alert">Le catalogue est indisponible : @string.Join(" ", Model.Status.Errors)</p>
    }
</section>
