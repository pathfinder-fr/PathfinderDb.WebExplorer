@using PathfinderDb.Data.Runtime
@inject IDataSnapshotProvider SnapshotProvider
@{
    var catalogStatus = SnapshotProvider.Status;
}
<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} · Pathfinder FR DB" : "Pathfinder FR DB")</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" href="/">
                <img src="/images/pf-fr-db.png" alt="Pathfinder FR DB" />
                <span class="edition-label">Pathfinder première édition</span>
            </a>
            <nav class="main-nav" aria-label="Navigation principale">
                <a href="/dons">Dons@if (catalogStatus.State == DataLoadState.Ready) { <span class="nav-count">@catalogStatus.FeatCount</span> }</a>
                <a href="/sorts">Sorts@if (catalogStatus.State == DataLoadState.Ready) { <span class="nav-count">@catalogStatus.SpellCount</span> }</a>
                <a href="/monstres">Monstres@if (catalogStatus.State == DataLoadState.Ready) { <span class="nav-count">@catalogStatus.MonsterCount</span> }</a>
            </nav>
        </div>
    </header>
    <main class="shell page-content">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="shell">Référence Pathfinder en français · données publiques</div>
    </footer>
</body>
</html>
