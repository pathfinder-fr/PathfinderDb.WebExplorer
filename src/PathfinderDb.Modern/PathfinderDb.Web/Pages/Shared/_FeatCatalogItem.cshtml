@model PathfinderDb.Data.Domain.Feat
<li class="catalog-item">
    <article>
        <h3><a href="/dons/detail/@Model.Id">@Model.Name</a></h3>
        <div class="catalog-summary-details">
        @if (Model.Types.Count > 0)
        {
            <span><strong>Types :</strong> @string.Join(", ", Model.Types.Select(CatalogText.FormatFeatType))</span>
        }
        @if (Model.Prerequisites.Count > 0)
        {
            <span><strong>Pré-requis :</strong> @string.Join(" ; ", Model.Prerequisites.Select(CatalogText.FormatPrerequisite))</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Source?.Id))
        {
            <span><strong>Source :</strong> @CatalogText.FormatSource(Model.Source.Id)</span>
        }
        </div>
    </article>
</li>
