@page "/monstres/detail/{slug}"
@model PathfinderDb.Web.Pages.Monsters.DetailModel
@{
    ViewData["Title"] = Model.Monster!.Name;
}
<article class="page-card">
    <p><a href="/monstres">← Tous les monstres</a></p>
    <p class="eyebrow">Monstre</p>
    <h1>@Model.Monster!.Name</h1>
    <dl class="detail-grid">
        <div><dt>CR</dt><dd>@(Model.Monster.ChallengeRating is { } challengeRating ? CatalogText.FormatChallengeRating(challengeRating) : "—")</dd></div>
        <div><dt>Type</dt><dd>@(Model.Monster.Type is { } type ? CatalogText.FormatMonsterType(type) : "—")</dd></div>
        <div><dt>Environnement</dt><dd>@Model.Monster.Environment</dd></div>
        <div><dt>Climat</dt><dd>@Model.Monster.Climate</dd></div>
    </dl>
    <p>Cette fiche est un résumé de catalogue : le jeu de données actuel ne fournit pas de statblock complet.</p>
</article>
