@model PathfinderDb.Data.Domain.Spell
<li class="catalog-item">
    <article>
        <h3><a href="/sorts/detail/@Model.Id">@Model.Name</a></h3>
        <div class="catalog-summary-details">
        @if (!string.IsNullOrWhiteSpace(Model.School))
        {
            <span><strong>École :</strong> @CatalogText.FormatSpellSchool(Model.School)</span>
        }
        @if (Model.Levels.Count > 0)
        {
            <span><strong>Niveaux :</strong> @string.Join(", ", Model.Levels.Select(level => $"{CatalogText.FormatSpellList(level.List)} {level.Level}"))</span>
        }
        @if (Model.ComponentKinds.Count > 0)
        {
            <span><strong>Composantes :</strong> @string.Join(", ", Model.ComponentKinds.Select(CatalogText.FormatSpellComponent))</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Source?.Id))
        {
            <span><strong>Source :</strong> @CatalogText.FormatSource(Model.Source.Id)</span>
        }
        </div>
    </article>
</li>
