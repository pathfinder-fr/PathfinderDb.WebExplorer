@model PathfinderDb.Data.Domain.Monster
<li class="catalog-item">
    <article>
        <h3><a href="/monstres/detail/@Model.Id">@Model.Name</a></h3>
        <div class="catalog-summary-details">
        @if (Model.ChallengeRating is { } challengeRating)
        {
            <span><strong>FP :</strong> @CatalogText.FormatChallengeRating(challengeRating)</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Type))
        {
            <span><strong>Type :</strong> @CatalogText.FormatMonsterType(Model.Type)</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Climate))
        {
            <span><strong>Climat :</strong> @CatalogText.FormatCreatureClimate(Model.Climate)</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Environment))
        {
            <span><strong>Environnement :</strong> @CatalogText.FormatCreatureEnvironment(Model.Environment)</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Source?.Id))
        {
            <span><strong>Source :</strong> @CatalogText.FormatSource(Model.Source.Id)</span>
        }
        </div>
    </article>
</li>
